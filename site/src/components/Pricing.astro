---
const github = "https://github.com/andresCamp/spectr";
---

<section class="pricing" id="pricing">
  <div class="wrap">
    <h2 class="price-title">Pay once. Own it forever.</h2>
    <p class="price-body">
      Try everything free for 48 hours. Then $14.99, once. Updates included.
    </p>
    <div class="price-ctas">
      <a class="btn btn-primary" href="https://apps.apple.com/app/spectr">Purchase $14.99</a>
    </div>
    <p class="price-alt">
      Not sure yet? <a href={`${github}/releases/latest`}>Download for Mac</a> and start the trial.
    </p>
  </div>
</section>

<style>
  .pricing {
    padding: 120px 0;
    text-align: center;
    border-top: 1px solid var(--divider-color);
  }

  .price-title {
    font-size: clamp(30px, 5vw, 44px);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .price-body {
    margin-top: 14px;
    font-size: 17px;
    color: var(--text-muted);
  }

  .price-ctas {
    margin-top: 32px;
    display: flex;
    justify-content: center;
  }

  .price-alt {
    margin-top: 16px;
    font-size: 13.5px;
    color: var(--text-muted);
  }
</style>
