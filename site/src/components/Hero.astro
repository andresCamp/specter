---
const github = "https://github.com/andresCamp/spectr";
---

<section class="hero" id="hero">
  <canvas class="hero-mosaic" id="hero-mosaic" aria-hidden="true"></canvas>
  <div class="hero-vignette" aria-hidden="true"></div>

  <div class="hero-content wrap">
    <h1 class="hero-title">Markdown, beautifully.</h1>
    <p class="hero-sub">
      Spectr is a fast, native editor that makes every .md file on your Mac look incredible.
    </p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href={`${github}/releases/latest`}>Download for Mac</a>
      <a class="btn btn-secondary" href="#pricing">Purchase $14.99</a>
    </div>
    <p class="hero-meta mono">
      Free 48-hour trial, then $14.99 once.&ensp;macOS 14+.&ensp;Open source.
    </p>
  </div>

  <div class="hero-window-slot wrap">
    <div class="app-window hero-window" id="app-window">
      <div class="window-chrome">
        <div class="traffic-lights" aria-hidden="true">
          <span class="light close"></span>
          <span class="light min"></span>
          <span class="light max"></span>
        </div>
        <span class="window-title">welcome.md</span>
        <button class="mode-toggle mono" id="mode-toggle" aria-pressed="false">
          Raw&ensp;<kbd>⌘R</kbd>
        </button>
      </div>

      <div class="window-body">
        <div class="doc-header">
          <canvas class="doc-mosaic" id="doc-mosaic" aria-hidden="true"></canvas>
          <div class="doc-meta">
            <span class="doc-meta-item"><span class="doc-meta-label">path</span> ~/Documents/welcome.md</span>
            <span class="doc-meta-item"><span class="doc-meta-label">edited</span> today</span>
          </div>
        </div>

        <div class="doc-views">
          <div class="doc-rendered" id="doc-rendered">
            <p class="md-h1">Hello, Spectr</p>
            <p>This is a plain <code class="md-code">.md</code> file on disk, rendered <strong>as you type</strong>. No preview pane, no split view. Click anywhere and it is still just text.</p>
            <p class="md-h2">Today</p>
            <p class="md-task"><button class="md-checkbox checked" aria-pressed="true" aria-label="Toggle: Hide the syntax, keep the text"></button><span class="md-done">Hide the syntax, keep the text</span></p>
            <p class="md-task"><button class="md-checkbox checked" aria-pressed="true" aria-label="Toggle: Give every document a fingerprint"></button><span class="md-done">Give every document a fingerprint</span></p>
            <p class="md-task"><button class="md-checkbox" aria-pressed="false" aria-label="Toggle: Ship it"></button><span>Ship it</span></p>
            <p class="md-quote">The editor is the renderer.</p>
          </div>
          <pre class="doc-raw mono" id="doc-raw" hidden></pre>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 148px 0 0;
    overflow: hidden;
  }

  .hero-mosaic {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      92% 66% at 50% 38%,
      color-mix(in srgb, var(--bg) 90%, transparent) 0%,
      color-mix(in srgb, var(--bg) 42%, transparent) 55%,
      transparent 100%
    );
  }

  .hero-content {
    position: relative;
    text-align: center;
  }

  .hero-title {
    font-size: clamp(42px, 7.5vw, 76px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    animation: rise 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-sub {
    margin: 20px auto 0;
    font-size: clamp(17px, 2.2vw, 20px);
    color: var(--text-muted);
    max-width: 46ch;
    animation: rise 700ms cubic-bezier(0.16, 1, 0.3, 1) 120ms both;
  }

  .hero-ctas {
    margin-top: 32px;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    animation: rise 700ms cubic-bezier(0.16, 1, 0.3, 1) 240ms both;
  }

  .hero-meta {
    margin-top: 18px;
    font-size: 11.5px;
    color: var(--text-muted);
    opacity: 0.85;
    animation: rise 700ms cubic-bezier(0.16, 1, 0.3, 1) 340ms both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-window-slot {
    position: relative;
    margin-top: 64px;
    animation: rise 800ms cubic-bezier(0.16, 1, 0.3, 1) 460ms both;
  }

  .hero-window {
    max-width: 760px;
    margin: 0 auto;
  }

  .mode-toggle {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    font-size: 11px;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--code-border);
    border-radius: 999px;
    padding: 4px 10px;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .mode-toggle:hover {
    color: var(--trim-color);
    border-color: color-mix(in srgb, var(--trim-color) 50%, transparent);
  }

  .doc-mosaic {
    width: 100%;
    height: 128px;
  }

  .doc-views {
    padding: 20px 32px 40px;
    min-height: 340px;
  }

  .doc-rendered,
  .doc-raw {
    transition: opacity 130ms ease;
  }

  .doc-rendered p {
    margin: 0;
  }

  .doc-rendered p + p {
    margin-top: 4px;
  }

  .doc-raw {
    font-size: 13px;
    line-height: 1.72;
    color: var(--text-muted);
    white-space: pre-wrap;
  }

  @media (max-width: 560px) {
    .hero {
      padding-top: 120px;
    }
    .doc-views {
      padding: 16px 20px 32px;
    }
  }
</style>

<script>
  import { mountMosaic } from "../scripts/mosaic.js";

  const hero = document.getElementById("hero");
  const heroCanvas = document.getElementById("hero-mosaic");
  mountMosaic(heroCanvas, {
    seed: "Spectr is the most beautiful way to read and edit markdown on macOS.",
    interactive: true,
    pointerTarget: hero,
    fadeBottom: 160,
  });

  const docCanvas = document.getElementById("doc-mosaic");
  mountMosaic(docCanvas, {
    seed: "# Hello, Spectr — welcome.md",
    interactive: true,
    fadeBottom: 24,
  });

  // The raw view mirrors the rendered task state, like a real file would.
  const rendered = document.getElementById("doc-rendered");
  const raw = document.getElementById("doc-raw");

  function taskStates() {
    return [...rendered.querySelectorAll(".md-checkbox")].map((box) =>
      box.classList.contains("checked") ? "x" : " "
    );
  }

  function buildRaw() {
    const [a, b, c] = taskStates();
    raw.textContent = `# Hello, Spectr

This is a plain \`.md\` file on disk, rendered
**as you type**. No preview pane, no split view.
Click anywhere and it is still just text.

## Today

- [${a}] Hide the syntax, keep the text
- [${b}] Give every document a fingerprint
- [${c}] Ship it

> The editor is the renderer.`;
  }

  buildRaw();
  document.addEventListener("spectr:task-toggle", (e) => {
    if (rendered.contains(e.target)) buildRaw();
  });

  // Rendered/raw crossfade, matching the app's ⌘R timing (90ms out, 130ms in).
  const toggle = document.getElementById("mode-toggle");
  let isRaw = false;
  toggle.addEventListener("click", () => {
    const showing = isRaw ? raw : rendered;
    const next = isRaw ? rendered : raw;
    showing.style.opacity = "0";
    setTimeout(() => {
      showing.hidden = true;
      next.hidden = false;
      next.style.opacity = "0";
      requestAnimationFrame(() => {
        next.style.opacity = "1";
      });
      isRaw = !isRaw;
      toggle.setAttribute("aria-pressed", String(isRaw));
      toggle.innerHTML = isRaw ? "Rendered&ensp;<kbd>⌘R</kbd>" : "Raw&ensp;<kbd>⌘R</kbd>";
    }, 90);
  });
</script>
