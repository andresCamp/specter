{
  "name": "spectr-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "LICENSES",
      // TODO: create the namespace in the Cloudflare dashboard (Storage & Databases → KV)
      // and paste its id here before the first deploy.
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    // Test-mode price for prod_UuQbr77LFQfhJa ($14.99 one-time).
    // Swap for the live-mode price id at launch.
    "STRIPE_PRICE_ID": "price_1TubjqK1y82g6XylGHGojfoi"
  },
  // Secrets (set in dashboard → Worker → Settings → Variables and Secrets):
  //   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
  "observability": {
    "enabled": true
  }
}
