{
  "name": "spectr",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  // Astro builds the static site before wrangler uploads it (runs in CI too).
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "LICENSES",
      "id": "01dda305a0db40f4ad2605427b5d980f"
    }
  ],
  "vars": {
    // Test-mode price for prod_UuQbr77LFQfhJa ($14.99 one-time).
    // Swap for the live-mode price id at launch.
    "STRIPE_PRICE_ID": "price_1TubjqK1y82g6XylGHGojfoi"
  },
  // Secrets STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are stored encrypted on the
  // worker itself (Settings → Variables and Secrets) — never in this file: the repo is
  // public. Local dev values live in the gitignored .dev.vars.
  "observability": {
    "enabled": true
  }
}
